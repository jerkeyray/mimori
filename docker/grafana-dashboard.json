{
  "dashboard": {
    "id": null,
    "title": "Mimori Raft Cluster",
    "tags": ["raft", "mimori"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Node States (Leader)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "raft_node_is_leader",
            "legendFormat": "{{node_id}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 1, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Current Term",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "raft_term",
            "legendFormat": "{{node_id}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Commit Index",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          {
            "expr": "raft_commit_index",
            "legendFormat": "{{node_id}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Proposals Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [
          {
            "expr": "rate(raft_proposals_total[5m])",
            "legendFormat": "{{node_id}} - {{status}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Replication Lag",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [
          {
            "expr": "raft_replication_lag",
            "legendFormat": "{{node_id}} -> {{peer}}",
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": false
}
